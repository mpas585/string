+# ---- 言語間でキーがそろっているか ----
+def flat_keys(d, prefix=''):
+    out = []
+    if isinstance(d, dict):
+        for k, v in d.items():
+            out += flat_keys(v, prefix + '.' + str(k))
+    elif isinstance(d, list):
+        for i, v in enumerate(d):
+            out += flat_keys(v, prefix + '[%d]' % i)
+    else:
+        out.append(prefix)
+    return out
